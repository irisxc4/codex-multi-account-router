<Window x:Class="CodexRouter.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180" Height="32"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border x:Name="PillRoot"
            BorderThickness="1"
            CornerRadius="14"
            Padding="6,0"
            Cursor="Hand"
            MouseLeftButtonDown="OnPillMouseLeftButtonDown"
            MouseMove="OnPillMouseMove"
            MouseLeftButtonUp="OnPillMouseLeftButtonUp"
            LostMouseCapture="OnPillLostMouseCapture">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#F2171B21" />
                <Setter Property="BorderBrush" Value="#48515E" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FA1C2129" />
                        <Setter Property="BorderBrush" Value="#697585" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="24" Height="24" VerticalAlignment="Center">
                <Border Width="24" Height="24"
                        Background="#252B34"
                        BorderBrush="#566171"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding AccountInitial}"
                               Foreground="#F3F5F7"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Fill="#6EE7B7"
                         Stroke="#171B21"
                         StrokeThickness="1.5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-1,-1" />
            </Grid>
            <TextBlock Grid.Column="1"
                       Text="{Binding PillAccountName}"
                       ToolTip="{Binding PillAccountName}"
                       Foreground="#F1F3F5"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="8,0,7,0" />
            <Grid Grid.Column="2" Width="20" Height="28" VerticalAlignment="Center">
                <Path Data="M 5,9 L 10,14 L 15,9"
                      Stroke="#AEB5BF"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Grid>
    </Border>
</Window>
