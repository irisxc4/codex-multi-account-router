<Window x:Class="CodexRouter.Overlay.DeviceCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexRouter.Overlay"
        Title="{x:Static local:UiText.DeviceCodeDialogTitle}"
        Width="360" Height="218"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#17191E"
        Foreground="#E7E9ED"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static local:UiText.DeviceCodeDialogTitle}"
                   FontSize="15" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{x:Static local:UiText.DeviceCodeDialogDescription}"
                   Margin="0,6,0,12" FontSize="10.5" Foreground="#969CA6"
                   TextWrapping="Wrap" />
        <Border Grid.Row="2" Background="#242830" BorderBrush="#454B56"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBox x:Name="CodeTextBox" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Foreground="#F2F3F5"
                     FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                     TextAlignment="Center" HorizontalContentAlignment="Center"
                     IsReadOnlyCaretVisible="True" />
        </Border>
        <TextBlock Grid.Row="3" Text="{x:Static local:UiText.DeviceCodeSecurityHint}"
                   Margin="0,10,0,0" FontSize="9.5" Foreground="#8D939D"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="OnCopyClick" Content="{x:Static local:UiText.CopyDeviceCode}"
                    MinWidth="96" Padding="10,6" Margin="0,0,8,0"
                    Background="#2A2F37" BorderBrush="#4A515D" Foreground="#ECEEF2" />
            <Button Click="OnCloseClick" Content="{x:Static local:UiText.Close}"
                    MinWidth="72" Padding="10,6"
                    Background="#202329" BorderBrush="#383D46" Foreground="#B7BCC4" />
        </StackPanel>
    </Grid>
</Window>
