<Window x:Class="CodexRouter.Overlay.AccountAliasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexRouter.Overlay"
        Title="{x:Static local:UiText.AddAccountTitle}" Width="330" Height="184"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#17191E">
    <Border BorderBrush="#464B55" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeadingText" Text="{x:Static local:UiText.AddAccount}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="{x:Static local:UiText.LocalAliasDescription}"
                       Foreground="#9297A1" FontSize="10.5" Margin="0,4,0,10" TextWrapping="Wrap" />
            <TextBox x:Name="AliasBox" Grid.Row="2" Height="32"
                     MaxLength="64"
                     Background="#22262D" Foreground="#F4F4F5"
                     BorderBrush="#454A54" BorderThickness="1"
                     Padding="9,5" FontFamily="Segoe UI Variable Text, Segoe UI"
                     VerticalContentAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource FlatButton}" Content="{x:Static local:UiText.Cancel}" Click="OnCancel" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Style="{StaticResource FlatButton}" Content="{x:Static local:UiText.Continue}" Click="OnContinue" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
